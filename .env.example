# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env
# Everything here has a working default except ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Which store to use: "sqlite" (default, zero setup) or "mongo".
# Swap this one value and every API endpoint keeps working - the repository
# layer in server/db/ hides the difference from the routes.
DB_DRIVER=sqlite

# SQLite: path to the database file (created automatically on first run).
SQLITE_PATH=./data/app.db

# MongoDB: only needed when DB_DRIVER=mongo
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=claude_starter

# --- Claude AI -------------------------------------------------------------
# Get a key at https://console.anthropic.com  ->  API Keys
# Leave it empty and the app still runs: /api/ai falls back to a local mock
# stream so the UI can be demoed without a key.
ANTHROPIC_API_KEY=

# Model + reasoning effort. claude-opus-5 is the current flagship.
# Cheaper alternatives: claude-sonnet-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8192

# --- Uploads ---------------------------------------------------------------
# Max CSV upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880
